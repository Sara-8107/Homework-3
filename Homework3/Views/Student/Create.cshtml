@model Homework3.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<h2>Add New Student</h2>

<form asp-action="Add" method="post">
    <div class="form-group mb-3">
        <label>Student Name</label>
        <input asp-for="StudentName" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label>Registration Number</label>
        <input asp-for="RegistrationNumber" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label>Department</label>
        <input asp-for="Department" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label>Attendance Percentage</label>
        <input asp-for="AttendencePercentage" class="form-control" type="number" step="0.01" required />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>